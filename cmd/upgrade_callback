#!/bin/bash
# BEGIN shared hook logging：以下公共日志块在六个钩子中保持一致。
HOOK_LOG_FILE=/tmp/install_hermes_agent.log
HOOK_NAME="${0##*/}"
HOOK_STAGE=logging
HOOK_LOG_READY=0
exec {HOOK_ORIGINAL_STDERR}>&2

hook_append_toast() {
    local file="${TRIM_TEMP_LOGFILE:-}"
    [[ -n "$file" ]] || return 0
    if [[ -L "$file" || ( -e "$file" && ! -f "$file" ) ]]; then
        printf 'ERROR: refusing non-regular fnOS toast file: %s\n' "$file" >&2
        return 0
    fi
    # 只追加，不覆盖 fnOS 或 helper 已写入的更具体提示。
    { if [[ -s "$file" ]]; then printf '\n'; fi; printf '%s\n' "$*"; } >> "$file" ||
        printf 'ERROR: cannot append fnOS failure notice: %s\n' "$file" >&2
    return 0
}

hook_record() {
    printf '%s [%s] %s rc=%s stage=%s uid=%s TRIM_APPDEST=%q TRIM_PKGHOME=%q TRIM_PKGVAR=%q\n' \
        "$(date '+%Y-%m-%d %H:%M:%S%z')" "$HOOK_NAME" "$1" "$2" "$HOOK_STAGE" "$EUID" \
        "${TRIM_APPDEST:-}" "${TRIM_PKGHOME:-}" "${TRIM_PKGVAR:-}"
}

# 失败时摘录本次运行写入日志的最后几行，让 fnOS 对话框直接显示具体原因。
hook_log_excerpt() {
    local line toast="${TRIM_TEMP_LOGFILE:-}"
    local -a lines=()
    [[ "$HOOK_LOG_READY" == 1 && -r "$HOOK_LOG_FILE" ]] || return 0
    while IFS= read -r line; do
        if [[ "$line" == *" [$HOOK_NAME] BEGIN rc=- "* ]]; then lines=(); continue; fi
        [[ -n "$line" && "$line" != *" [$HOOK_NAME] END rc="* ]] || continue
        # 已由 toast_err 写入提示文件的原文不再重复。
        if [[ -f "$toast" ]] && grep -qxF -- "$line" "$toast" 2>/dev/null; then continue; fi
        lines+=("${line:0:300}")
        (( ${#lines[@]} <= 8 )) || lines=("${lines[@]:1}")
    done < <(tail -n 200 -- "$HOOK_LOG_FILE" 2>/dev/null)
    (( ${#lines[@]} )) || return 0
    printf '日志摘录：\n'
    printf '  %s\n' "${lines[@]}"
}

hook_exit() {
    local rc="$1" notice excerpt=""
    trap - EXIT ERR
    if [[ "$HOOK_LOG_READY" == 1 ]]; then
        if ! hook_record END "$rc"; then
            HOOK_LOG_READY=0
            printf 'ERROR: cannot write END (rc=%s) to %s\n' "$rc" "$HOOK_LOG_FILE" >&"$HOOK_ORIGINAL_STDERR"
        fi
    else
        hook_record BEGIN - >&"$HOOK_ORIGINAL_STDERR" || :
        hook_record END "$rc" >&"$HOOK_ORIGINAL_STDERR" || :
    fi
    if (( rc != 0 )); then
        notice="${HOOK_NAME} 阶段 ${HOOK_STAGE} 失败（退出码 ${rc}，行 ${HOOK_FAILED_LINE:-unknown}）；日志：${HOOK_LOG_FILE}"
        if [[ "$HOOK_LOG_READY" != 1 ]]; then
            notice="${notice}（日志不可写，未能完整保存）"
            printf '%s\n' "$notice" >&"$HOOK_ORIGINAL_STDERR"
        else
            excerpt="$(hook_log_excerpt)"
            printf '%s\n' "$notice" >&2
        fi
        hook_append_toast "$notice${excerpt:+$'\n'$excerpt}"
    fi
    exit "$rc"
}
trap 'hook_exit "$?"' EXIT

# 仅首次创建时使用私有 umask 和 noclobber 独占打开。
if [[ -L "$HOOK_LOG_FILE" || ( -e "$HOOK_LOG_FILE" && ! -f "$HOOK_LOG_FILE" ) ]]; then
    printf 'ERROR: refusing symlink or non-regular hook log: %s\n' "$HOOK_LOG_FILE" >&"$HOOK_ORIGINAL_STDERR"
    exit 1
fi
if [[ ! -e "$HOOK_LOG_FILE" ]]; then
    (umask 077; set -o noclobber; : > "$HOOK_LOG_FILE") || {
        printf 'ERROR: cannot create hook log: %s\n' "$HOOK_LOG_FILE" >&"$HOOK_ORIGINAL_STDERR"
        exit 1
    }
fi
if [[ -L "$HOOK_LOG_FILE" || ! -f "$HOOK_LOG_FILE" || ! -w "$HOOK_LOG_FILE" ]]; then
    printf 'ERROR: hook log is not a writable regular file: %s\n' "$HOOK_LOG_FILE" >&"$HOOK_ORIGINAL_STDERR"
    exit 1
fi
if ! { exec >> "$HOOK_LOG_FILE" 2>&1; }; then
    printf 'ERROR: cannot append hook log: %s\n' "$HOOK_LOG_FILE" >&"$HOOK_ORIGINAL_STDERR"
    exit 1
fi
# 写入前再校验已打开的文件本身，而不只是打开前的路径名。
if [[ -L "$HOOK_LOG_FILE" || ! -f /proc/self/fd/1 || ! "$HOOK_LOG_FILE" -ef /proc/self/fd/1 ]]; then
    printf 'ERROR: hook log changed while opening: %s\n' "$HOOK_LOG_FILE" >&"$HOOK_ORIGINAL_STDERR"
    exit 1
fi
if ! { printf '\n%s\n' '------------------------------------------------------------------------' && hook_record BEGIN -; }; then
    printf 'ERROR: cannot write BEGIN to hook log: %s\n' "$HOOK_LOG_FILE" >&"$HOOK_ORIGINAL_STDERR"
    exit 1
fi
HOOK_LOG_READY=1
HOOK_STAGE=path-validation
# END shared hook logging：公共日志块结束。


set -e

# FPK 的 app/ 直接部署在 APPDEST，而不是 APPDEST/app。
for name in TRIM_APPDEST TRIM_PKGHOME TRIM_PKGVAR; do
    value="${!name}"
    case "$value" in
        /*) ;;
        *) printf '%s must be an absolute path\n' "$name" >&2; exit 1 ;;
    esac
    while [[ "$value" == */ && "$value" != / ]]; do value="${value%/}"; done
    case "$value/" in
        /|//|*/../*|*/./*) printf 'Invalid path: %s\n' "$name" >&2; exit 1 ;;
    esac
    printf -v "$name" '%s' "$value"
done
mkdir -p -- "$TRIM_PKGVAR"
LOG_FILE="${TRIM_PKGVAR}/info.log"
: >> "$LOG_FILE"

log_msg() {
    local msg="$(date '+%Y-%m-%d %H:%M:%S') - [upgrade] $1"
    printf '%s\n' "$msg"
    printf '%s\n' "$msg" >> "${LOG_FILE}" ||
        printf 'WARNING: cannot append summary log: %s\n' "$LOG_FILE" >&2
}

toast_err() {
    printf '%s\n' "$*" >&2
    hook_append_toast "$*"
}

# 记录失败行，EXIT trap 保留退出码并追加阶段/日志指引
trap 'HOOK_FAILED_LINE=$LINENO' ERR

DATA_DIR="${TRIM_PKGHOME}/data"
VAR_DIR="${TRIM_PKGVAR}"
VENV_DIR="${DATA_DIR}/venv"
HERMES="${VENV_DIR}/bin/hermes"
APP_DIR="${TRIM_APPDEST}"
UV_BIN="${DATA_DIR}/bin"

if [[ -L "$DATA_DIR" || ( -e "$DATA_DIR" && ! -d "$DATA_DIR" ) ]]; then
    toast_err "Existing data path is not a plain directory; preserved without changes: $DATA_DIR"
    exit 1
fi
if [[ -d "$DATA_DIR" ]]; then
    log_msg "Preserving existing user data: $DATA_DIR; only missing defaults will be added"
fi
export HOME="${DATA_DIR}" HERMES_HOME="${DATA_DIR}"

# uv 缓存目录放到 DATA_DIR 下，确保和 venv 同一文件系统，hardlink 可用
export UV_CACHE_DIR="${DATA_DIR}/.uv-cache"

# ---------------------------------------------------------------------------
# 私有 uv 固定为 0.13.5，从国内 PyPI 镜像下载官方 wheel 并按固定 SHA256 校验，不使用 PATH 里的 uv
# ---------------------------------------------------------------------------
ensure_uv() {
    local DATA_REAL BIN_REAL
    DATA_REAL=$(readlink -m -- "$DATA_DIR") || return 1
    BIN_REAL=$(readlink -m -- "$UV_BIN") || return 1
    if [[ "$UV_BIN" != "$DATA_DIR/bin" || "$BIN_REAL" != "$DATA_REAL/bin" ]]; then
        toast_err 'uv: private binary directory escapes DATA_DIR; no tool was executed or replaced'
        return 1
    fi
    local UV_PATH="${UV_BIN}/uv" UV_VERSION=""
    local VERSION_RE='^uv 0\.13\.5( \([^()[:cntrl:]]+\))?$'
    # 旧 uv 即使可运行也可能无法读取当前 lock，只复用精确版本。
    if [[ -f "$UV_PATH" && ! -L "$UV_PATH" && -x "$UV_PATH" ]]; then
        if UV_VERSION=$("$UV_PATH" --version) && [[ "$UV_VERSION" =~ $VERSION_RE ]]; then
            UV="$UV_PATH"
            log_msg "uv found (persistent): ${UV}; version: ${UV_VERSION}"
            return 0
        fi
        log_msg "uv requires 0.13.5; replacing incompatible private uv: ${UV_VERSION:-version check failed}"
    fi

    local ARCH UV_SHA256 UV_WHL UV_WHL_SHA256 UV_WHL_PATH
    ARCH="$(uname -m)" || return 1
    case "$ARCH" in
        x86_64)
            UV_SHA256="f68d291c75783122dad58ab77def0e13f3233f358731db5d6d7e8715603b928f"
            UV_WHL="uv-0.13.5-py3-none-manylinux_2_17_x86_64.manylinux2014_x86_64.whl"
            UV_WHL_SHA256="fa8d26e08e34c29c0c4e820cf3181757086d547240b4f4d31ff1d8bd810ca946"
            UV_WHL_PATH="3a/ad/3c2a81d66d1839063662e5b6c0002ec31f8ee987dbc5295747627ca6160a" ;;
        aarch64)
            UV_SHA256="4bb69cf95ed13f23713bb7bc09f241896ea0c75b7c557e615a20604b82f9c403"
            UV_WHL="uv-0.13.5-py3-none-manylinux_2_17_aarch64.manylinux2014_aarch64.musllinux_1_1_aarch64.whl"
            UV_WHL_SHA256="2386c2dc9b59fc1d39b1c500e4319d71d3268232eb3b38e29cd6775d6269e8d4"
            UV_WHL_PATH="e8/2e/5bf9acf9d11fb790420e258a875e13bba36bc890858350642aca185efe0e" ;;
        *) toast_err "uv 0.13.5: unsupported architecture: ${ARCH}"; return 1 ;;
    esac
    local UV_TAR="uv-${ARCH}-unknown-linux-gnu"
    local UV_URL="https://github.com/astral-sh/uv/releases/download/0.13.5/${UV_TAR}.tar.gz"
    local UV_MIRROR="https://hermes-assets.nousresearch.com/upstream/sha256/${UV_SHA256}"
    local TMP_DIR UV_GZ UV_WHL_FILE CANDIDATE URL ACQUIRED=0 BACKUP_DIR="" PUBLISHED=0 UNZIP_TOOL=""
    if ! mkdir -p -- "$UV_BIN" || ! TMP_DIR="$(mktemp -d "${DATA_DIR}/.uv-bootstrap.XXXXXX")"; then
        toast_err 'uv: cannot create private staging directory'
        return 1
    fi
    UV_GZ="${TMP_DIR}/uv.tar.gz"
    UV_WHL_FILE="${TMP_DIR}/${UV_WHL}"
    CANDIDATE="${TMP_DIR}/${UV_TAR}/uv"

    uv_fetch() {
        curl --disable --fail --location --silent --show-error \
            --proto '=https' --proto-redir '=https' --max-redirs 5 \
            --connect-timeout 10 --max-time 180 --retry 2 --retry-delay 2 \
            --retry-max-time 240 --max-filesize 52428800 --output "$1" "$2"
    }

    # 在线安装版：优先从国内 PyPI 镜像取官方 uv wheel（同一二进制，文件路径与 pypi.org 一致），
    # 用固定 SHA256 校验后只解出 uv-0.13.5.data/scripts/uv。解压用 unzip 或系统 python3，
    # 两者都没有时回退到 GitHub 的 tar.gz。
    if command -v unzip >/dev/null 2>&1; then
        UNZIP_TOOL=unzip
    elif command -v python3 >/dev/null 2>&1 && python3 -c 'import zipfile' >/dev/null 2>&1; then
        UNZIP_TOOL=python3
    fi
    if [[ -n "$UNZIP_TOOL" ]]; then
        for URL in "https://mirrors.aliyun.com/pypi/packages/${UV_WHL_PATH}/${UV_WHL}" \
                   "https://pypi.tuna.tsinghua.edu.cn/packages/${UV_WHL_PATH}/${UV_WHL}"; do
            log_msg "uv 0.13.5 (${ARCH}): downloading wheel ${URL}"
            if ! uv_fetch "$UV_WHL_FILE" "$URL"; then
                log_msg "uv wheel download failed: ${URL}"
                continue
            fi
            if ! printf '%s  %s\n' "$UV_WHL_SHA256" "$UV_WHL_FILE" | sha256sum --check; then
                log_msg "uv wheel SHA256 verification failed: ${URL}"
                rm -f -- "$UV_WHL_FILE"
                continue
            fi
            log_msg "uv wheel SHA256 verified: ${UV_WHL_SHA256}"
            mkdir -p -- "${TMP_DIR}/${UV_TAR}"
            EXTRACTED=0
            if [[ "$UNZIP_TOOL" == unzip ]]; then
                unzip -p -- "$UV_WHL_FILE" 'uv-0.13.5.data/scripts/uv' > "$CANDIDATE" && EXTRACTED=1
            else
                python3 - "$UV_WHL_FILE" "$CANDIDATE" <<'PY' && EXTRACTED=1
import shutil, sys, zipfile
with zipfile.ZipFile(sys.argv[1]) as whl, whl.open('uv-0.13.5.data/scripts/uv') as src, open(sys.argv[2], 'wb') as dst:
    shutil.copyfileobj(src, dst)
PY
            fi
            if [[ "$EXTRACTED" == 1 && -s "$CANDIDATE" ]] && chmod 755 -- "$CANDIDATE"; then
                ACQUIRED=1
                break
            fi
            log_msg "uv wheel extraction failed (${UNZIP_TOOL}): ${URL}"
            rm -f -- "$CANDIDATE" "$UV_WHL_FILE"
        done
    else
        log_msg 'uv: neither unzip nor python3 available; using GitHub tar.gz'
    fi
    if [[ "$ACQUIRED" != 1 ]]; then
    for URL in "$UV_URL" "$UV_MIRROR"; do
        log_msg "uv 0.13.5 (${ARCH}): downloading ${URL}"
        if ! uv_fetch "$UV_GZ" "$URL"; then
            log_msg "uv download failed: ${URL}"
            continue
        fi
        # 校验通过前不读取 tar，仅解压官方归档中的预期二进制路径。
        if ! printf '%s  %s\n' "$UV_SHA256" "$UV_GZ" | sha256sum --check; then
            log_msg "uv SHA256 verification failed: ${URL}"
            continue
        fi
        log_msg "uv SHA256 verified: ${UV_SHA256}"
        if ! tar -xzf "$UV_GZ" -C "$TMP_DIR" -- "${UV_TAR}/uv"; then
            log_msg "uv archive extraction failed: ${URL}"
            continue
        fi
        ACQUIRED=1
        break
    done
    fi
    if [[ "$ACQUIRED" != 1 ]]; then
        rm -rf -- "$TMP_DIR"
        toast_err 'uv 0.13.5 acquisition failed; existing private uv retained'
        return 1
    fi
    UV_VERSION=""
    if [[ ! -f "$CANDIDATE" || -L "$CANDIDATE" || ! -x "$CANDIDATE" ]] ||
        ! UV_VERSION=$("$CANDIDATE" --version) || [[ ! "$UV_VERSION" =~ $VERSION_RE ]]; then
        toast_err "uv candidate executable/version check failed: ${UV_VERSION:-unavailable}; expected uv 0.13.5"
        rm -rf -- "$TMP_DIR"
        return 1
    fi
    log_msg "uv candidate verified: ${UV_VERSION}"

    # 备份保留在 DATA_DIR。不先移走旧文件，发布用同文件系统的原子 rename。
    if [[ -e "$UV_PATH" || -L "$UV_PATH" ]]; then
        if [[ ! -f "$UV_PATH" && ! -L "$UV_PATH" ]]; then
            toast_err "uv: refusing to replace non-file: ${UV_PATH}"
            rm -rf -- "$TMP_DIR"
            return 1
        fi
        if ! BACKUP_DIR="$(mktemp -d "${UV_BIN}/.uv-backup.XXXXXX")" ||
            ! cp -pP -- "$UV_PATH" "${BACKUP_DIR}/uv"; then
            toast_err 'uv backup failed; existing private uv retained'
            rm -rf -- "$TMP_DIR"
            return 1
        fi
        log_msg "uv previous binary backup: ${BACKUP_DIR}/uv"
    fi
    if mv -fT -- "$CANDIDATE" "$UV_PATH"; then
        PUBLISHED=1
    fi
    UV_VERSION=""
    if [[ "$PUBLISHED" != 1 || ! -f "$UV_PATH" || -L "$UV_PATH" || ! -x "$UV_PATH" ]] ||
        ! UV_VERSION=$("$UV_PATH" --version) || [[ ! "$UV_VERSION" =~ $VERSION_RE ]]; then
        toast_err "uv publish failed: ${UV_VERSION:-executable unavailable}"
        if [[ -n "$BACKUP_DIR" ]]; then
            if cp -pP -- "${BACKUP_DIR}/uv" "${TMP_DIR}/uv.rollback" &&
                mv -fT -- "${TMP_DIR}/uv.rollback" "$UV_PATH"; then
                log_msg "uv rollback restored previous binary; backup: ${BACKUP_DIR}/uv"
            else
                toast_err "uv rollback failed; previous binary preserved at ${BACKUP_DIR}/uv"
            fi
        elif [[ "$PUBLISHED" == 1 ]]; then
            rm -f -- "$UV_PATH" || toast_err "uv: cannot remove failed publication: ${UV_PATH}"
        fi
        rm -rf -- "$TMP_DIR"
        return 1
    fi
    rm -rf -- "$TMP_DIR"
    UV="$UV_PATH"
    log_msg "uv installed (private): ${UV}; version: ${UV_VERSION}"
}

# ---------------------------------------------------------------------------
# 1. 读取目标版本号（从 hermes-version.env，manifest 不部署到设备）
# ---------------------------------------------------------------------------
HOOK_STAGE=version-config
if [ ! -f "${APP_DIR}/config/bootstrap/hermes-version.env" ]; then
    toast_err "hermes-version.env 不存在，请检查打包是否包含 config/bootstrap/"
    exit 1
fi
# shellcheck disable=SC1090
. "${APP_DIR}/config/bootstrap/hermes-version.env"
if [ -z "${HERMES_VERSION}" ]; then
    toast_err "hermes-version.env 中未定义 HERMES_VERSION"
    exit 1
fi
log_msg "hermes-agent target version: ${HERMES_VERSION}"

# ---------------------------------------------------------------------------
# 3. 从包内固定源码安装，安装和升级共用锁定同步/健康检查
# ---------------------------------------------------------------------------
HOOK_STAGE=runtime-helper
. "${APP_DIR}/config/bootstrap/install-runtime.sh"
HOOK_STAGE=ensure-uv
ensure_uv
HOOK_STAGE=ensure-node
ensure_node
HOOK_STAGE=install-runtime
install_runtime

# 让运行时沿用持久 uv，不以旧 executable/版本比较跳过健康校验。
if [ -x "${UV_BIN}/uv" ] && [ -d "${VENV_DIR}/bin" ] && [ ! -L "${VENV_DIR}/bin" ]; then
    if [[ ! -e "$VENV_DIR/bin/uv" && ! -L "$VENV_DIR/bin/uv" ]]; then
        ln -s "${UV_BIN}/uv" "${VENV_DIR}/bin/uv"
    fi
fi

# 清除版本缓存，让 monitor.js 下次启动时重新检测真实版本
rm -f "${VAR_DIR}/hermes_version.txt" || true
log_msg "version cache cleared"

# ---------------------------------------------------------------------------
# 4. 部署 prompts
# ---------------------------------------------------------------------------
HOOK_STAGE=deploy-prompts
PROMPTS_SRC="${APP_DIR}/config/prompts"
if [ -d "${PROMPTS_SRC}" ]; then
    # skills/ — 仅补缺失文件，保留用户修改
    if [ -d "${PROMPTS_SRC}/skills" ]; then
        mkdir -p "${DATA_DIR}/skills"
        cp -a -n "${PROMPTS_SRC}/skills/." "${DATA_DIR}/skills/"
        log_msg "skills redeployed"
    fi

    # SOUL.md — 不存在才复制
    if [ -f "${PROMPTS_SRC}/SOUL.md" ] && [ ! -e "${DATA_DIR}/SOUL.md" ] && [ ! -L "${DATA_DIR}/SOUL.md" ]; then
        cp -n -- "${PROMPTS_SRC}/SOUL.md" "${DATA_DIR}/SOUL.md"
        log_msg "SOUL.md deployed (missing)"
    fi

    # AGENTS.md — 不存在才复制
    if [ -f "${PROMPTS_SRC}/AGENTS.md" ] && [ ! -e "${DATA_DIR}/AGENTS.md" ] && [ ! -L "${DATA_DIR}/AGENTS.md" ]; then
        cp -n -- "${PROMPTS_SRC}/AGENTS.md" "${DATA_DIR}/AGENTS.md"
        log_msg "AGENTS.md deployed (missing)"
    fi

    # config.yaml — 不存在才复制
    if [ -f "${PROMPTS_SRC}/config.yaml" ] && [ ! -e "${DATA_DIR}/config.yaml" ] && [ ! -L "${DATA_DIR}/config.yaml" ]; then
        cp -n -- "${PROMPTS_SRC}/config.yaml" "${DATA_DIR}/config.yaml"
        log_msg "config.yaml deployed (missing)"
    fi
fi

# ---------------------------------------------------------------------------
# 5. 修复权限
# ---------------------------------------------------------------------------
HOOK_STAGE=permissions
if [ -n "${TRIM_USERNAME}" ]; then
    log_msg "=== 修复权限 ==="
    log_msg "TRIM_USERNAME=${TRIM_USERNAME}"
    log_msg "APP_DIR=${APP_DIR} owner=$(stat -c '%U:%G' "${APP_DIR}" || echo 'N/A') perms=$(stat -c '%a' "${APP_DIR}" || echo 'N/A')"
    log_msg "DATA_DIR=${DATA_DIR} owner=$(stat -c '%U:%G' "${DATA_DIR}" || echo 'N/A') perms=$(stat -c '%a' "${DATA_DIR}" || echo 'N/A')"

    if chown -R "${TRIM_USERNAME}:${TRIM_USERNAME}" "${APP_DIR}"; then
        log_msg "chown -R ${TRIM_USERNAME}:${TRIM_USERNAME} ${APP_DIR} → OK"
    else
        log_msg "chown -R ${TRIM_USERNAME}:${TRIM_USERNAME} ${APP_DIR} → FAILED (exit=$?)"
    fi
    if chmod 775 "${APP_DIR}"; then
        log_msg "chmod 775 ${APP_DIR} → OK"
    else
        log_msg "chmod 775 ${APP_DIR} → FAILED (exit=$?)"
    fi
    if repair_data_ownership; then
        log_msg "DATA_DIR ownership repaired; original modes preserved"
    else
        toast_err "数据归属修复失败；未完成升级，请查看权限错误日志：${HOOK_LOG_FILE}"
        exit 1
    fi

    log_msg "--- 权限修复后目录状态 ---"
    ls -la "${APP_DIR}" 2>&1 | while IFS= read -r line; do log_msg "  $line"; done
else
    log_msg "TRIM_USERNAME 为空，跳过权限修复"
fi

trap - ERR
log_msg "upgrade_callback finished successfully."
exit 0
