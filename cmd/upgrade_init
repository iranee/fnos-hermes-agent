#!/bin/bash

### 升级前回调 — 停止应用并清理残留 socket，避免解压新文件时冲突

TRIM_APPDEST="${TRIM_APPDEST:-/var/apps/hermes-agent}"
TRIM_PKGVAR="${TRIM_PKGVAR:-/vol1/@appdata/hermes-agent}"
LOG_FILE="${TRIM_PKGVAR}/info.log"

log_msg() {
    local msg="$(date '+%Y-%m-%d %H:%M:%S') - [upgrade_init] $1"
    echo "$msg" >> "${LOG_FILE}" 2>/dev/null || true
}

log_msg "=== upgrade_init start ==="
log_msg "TRIM_APPDEST=${TRIM_APPDEST}"
log_msg "TRIM_PKGVAR=${TRIM_PKGVAR}"
log_msg "TRIM_USERNAME=${TRIM_USERNAME:-<empty>}"

# 记录升级前目录状态
log_msg "--- 目录状态 (升级前) ---"
ls -la "${TRIM_APPDEST}" 2>&1 | while IFS= read -r line; do log_msg "  $line"; done

# 优雅终止残留进程（给予 gracefulShutdown 时间执行清理）
# fnOS 已在 upgrade_init 前发 SIGTERM，子进程可能未完全退出
# 先尝试温和终止 (SIGTERM)，等待 1 秒后仍未退出的再强制杀死
pkill -TERM -f "(bun|node).*(boot|monitor)\.js" 2>/dev/null || true
sleep 1

# 继续终止其他可能残留的进程
pkill -TERM -f "hermes.*gateway" 2>/dev/null || true
pkill -TERM -f "hermes.*dashboard" 2>/dev/null || true

# 温和终止超时后，使用 SIGKILL 确保进程退出
pkill -9 -f "(bun|node).*(boot|monitor)\.js" 2>/dev/null || true
pkill -9 -f "hermes.*gateway" 2>/dev/null || true
pkill -9 -f "hermes.*dashboard" 2>/dev/null || true

# 等待进程完全退出（最多 10 秒），避免文件句柄残留导致 fnOS 解压/权限设置失败
_wait=0
while [ ${_wait} -lt 10 ]; do
    _term_count=$(pgrep -f "(bun|node).*(boot|monitor)\.js" 2>/dev/null | wc -l)
    _gw_count=$(pgrep -f "hermes.*gateway" 2>/dev/null | wc -l)
    _dash_count=$(pgrep -f "hermes.*dashboard" 2>/dev/null | wc -l)
    
    if [ "${_term_count}" -eq 0 ] && [ "${_gw_count}" -eq 0 ] && [ "${_dash_count}" -eq 0 ]; then
        log_msg "等待 ${_wait}s 后进程已全部退出"
        break
    fi
    
    sleep 1
    _wait=$((_wait + 1))
done

# 检查是否仍有残留进程
if [ "${_wait}" -ge 10 ]; then
    _final_term=$(pgrep -f "(bun|node).*(boot|monitor)\.js" 2>/dev/null | wc -l)
    _final_gw=$(pgrep -f "hermes.*gateway" 2>/dev/null | wc -l)
    _final_dash=$(pgrep -f "hermes.*dashboard" 2>/dev/null | wc -l)
    _total=$(( _final_term + _final_gw + _final_dash ))
    if [ "${_total}" -gt 0 ]; then
        log_msg "警告：仍有 ${_total} 个进程残留 (${_final_term} monitor, ${_final_gw} gateway, ${_final_dash} dashboard)"
    else
        log_msg "等待 10s 后进程已全部退出"
    fi
else
    log_msg "进程清理完成 (等待 ${_wait}s)"
fi

# 兜底删除残留 socket
rm -f "${TRIM_APPDEST}/hermes-agent.sock" 2>/dev/null || true
rm -f "/var/apps/hermes-agent/target/hermes-agent.sock" 2>/dev/null || true
log_msg "socket 清理完成"

# 额外等待 2 秒，确保文件系统释放所有句柄
sleep 2

# 记录清理后目录状态
log_msg "--- 目录状态 (清理后) ---"
ls -la "${TRIM_APPDEST}" 2>&1 | while IFS= read -r line; do log_msg "  $line"; done

log_msg "=== upgrade_init end ==="
exit 0


