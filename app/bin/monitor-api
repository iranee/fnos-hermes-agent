#!/bin/bash
set -euo pipefail

fail() { printf '%s\n' "monitor-api: $*" >&2; exit 1; }
ACTION="${1:-}"
case "$ACTION" in
    health|status|webapp/status|dashboard/status) METHOD=GET ;;
    stop|restart|webapp/stop|dashboard/stop) METHOD=POST ;;
    *) fail 'Usage: monitor-api {health|status|webapp/status|dashboard/status|stop|restart|webapp/stop|dashboard/stop} [GET|POST]. Configure and start WebApp or Dashboard in the control panel.' ;;
esac
[[ $# -le 2 && "${2:-$METHOD}" == "$METHOD" ]] || fail "Action $ACTION requires $METHOD"

APP="${APP_DIR:-${TRIM_APPDEST:-}}"
if [[ -z "$APP" ]]; then
    APP="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
fi
DATA="${DATA_DIR:-${HERMES_HOME:-}}"
if [[ -z "$DATA" && -n "${TRIM_PKGHOME:-}" ]]; then DATA="${TRIM_PKGHOME}/data"; fi
[[ "$APP" == /* && "$APP" != / && "$DATA" == /* && "$DATA" != / ]] || fail 'Explicit application and Hermes data paths are required'
SOCKET="$APP/hermes-agent.sock"
TOKEN_FILE="$DATA/.monitor_token"
[[ -S "$SOCKET" ]] || fail "Monitor socket not found: $SOCKET"
[[ -r "$TOKEN_FILE" ]] || fail 'Monitor token is not readable for this application user'
TOKEN="$(<"$TOKEN_FILE")"
[[ "$TOKEN" =~ ^[a-f0-9]{48}$ ]] || fail 'Invalid monitor token'

# 这些请求头只是本地 Unix socket 的元数据，不会发往公网 TCP 端点。
exec curl --silent --show-error --fail-with-body --max-time 100 \
    --unix-socket "$SOCKET" -X "$METHOD" \
    -H 'Host: localhost' -H 'Origin: http://localhost' \
    -H 'X-Trim-Isadmin: true' -H "X-Trim-Userid: $(id -u)" \
    -H "X-Monitor-Token: $TOKEN" \
    "http://localhost/app/hermes-agent/api/$ACTION"
